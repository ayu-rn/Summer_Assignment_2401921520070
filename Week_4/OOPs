// ==========================================
// Problem 1: Interface Implementation
// ==========================================
interface test {
    int square(int n);
}

class arithmetic implements test {
    @Override
    public int square(int n) {
        return n * n;
    }
}

// ==========================================
// Problem 2: Inner and Outer Classes
// ==========================================
class Outer {
    void display() {
        System.out.println("This is the display method of the Outer class.");
    }

    class Inner {
        void display() {
            System.out.println("This is the display method of the Inner class.");
        }
    }
}

// ==========================================
// Problem 3: Class Point
// ==========================================
class Point {
    private int x;
    private int y;

    public Point() {
        this.x = 0;
        this.y = 0;
    }

    public Point(int x, int y) {
        this.x = x;
        this.y = y;
    }

    public void setX(int x) {
        this.x = x;
    }

    public void setY(int y) {
        this.y = y;
    }

    public void setXY(int x, int y) {
        this.x = x;
        this.y = y;
    }

    public void printPoint() {
        System.out.println("Point coordinates: (" + x + ", " + y + ")");
    }
}

// ==========================================
// Problem 4: Box and Box3d Inheritance
// ==========================================
class Box {
    protected double length;
    protected double breadth;

    public Box(double length, double breadth) {
        this.length = length;
        this.breadth = breadth;
    }

    public double getArea() {
        return length * breadth;
    }
}

class Box3d extends Box {
    private double height;

    public Box3d(double length, double breadth, double height) {
        super(length, breadth);
        this.height = height;
    }

    public double getVolume() {
        return getArea() * height;
    }
}

// ==========================================
// Main Runner Class
// ==========================================
public class OOPsAssignmentRunner {
    public static void main(String[] args) {
        
        // --- Executing Problem 1 ---
        System.out.println("--- Problem 1 Output ---");
        arithmetic calc = new arithmetic();
        int number = 5;
        System.out.println("The square of " + number + " is: " + calc.square(number));

        // --- Executing Problem 2 ---
        System.out.println("\n--- Problem 2 Output ---");
        Outer outerObj = new Outer();
        outerObj.display();
        Outer.Inner innerObj = outerObj.new Inner();
        innerObj.display();

        // --- Executing Problem 3 ---
        System.out.println("\n--- Problem 3 Output ---");
        Point p1 = new Point();
        System.out.print("Default Constructor - ");
        p1.printPoint();
        
        Point p2 = new Point(5, 10);
        System.out.print("Parameterized Constructor - ");
        p2.printPoint();
        
        p2.setXY(100, 200);
        System.out.print("After setXY - ");
        p2.printPoint();

        // --- Executing Problem 4 ---
        System.out.println("\n--- Problem 4 Output ---");
        Box3d myBox3d = new Box3d(5.0, 4.0, 3.0);
        System.out.println("Area of 3D Box base: " + myBox3d.getArea());
        System.out.println("Volume of 3D Box: " + myBox3d.getVolume());
    }
}
