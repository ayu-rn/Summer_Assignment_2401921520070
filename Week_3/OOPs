import java.util.Random;

// ==========================================
// Base Abstract Class
// ==========================================
abstract class Compartment {
    public abstract String notice();
}

// ==========================================
// Derived Classes
// ==========================================
class FirstClass extends Compartment {
    @Override
    public String notice() {
        return "Notice: This is a First Class compartment. Please keep your ticket handy.";
    }
}

class Ladies extends Compartment {
    @Override
    public String notice() {
        return "Notice: This compartment is reserved for Ladies only.";
    }
}

class General extends Compartment {
    @Override
    public String notice() {
        return "Notice: This is a General compartment. Unreserved seating.";
    }
}

class Luggage extends Compartment {
    @Override
    public String notice() {
        return "Notice: Luggage compartment. No passenger seating allowed.";
    }
}

